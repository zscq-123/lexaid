# 仅供本机 Docker 开发。生产环境请使用密钥管理服务，不要提交真实密码。
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_DATABASE=lexaid
MYSQL_USER=lexaid
MYSQL_PASSWORD=replace-with-a-local-app-password
MYSQL_PORT=3308

# 后端生产环境至少需要设置：
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:mysql://host:3306/lexaid
# SPRING_DATASOURCE_USERNAME=lexaid
# SPRING_DATASOURCE_PASSWORD=replace-me
# APP_JWT_SECRET=at-least-32-random-characters

# 后端 AI 问答和主观题评分
# DEEPSEEK_API_KEY=
# AI_MODEL=deepseek-flash

# 可选：仅将公开讨论观点整理交给单独的本地推理服务
# DISCUSSION_AI_BASE_URL=http://127.0.0.1:11434/v1
# DISCUSSION_AI_MODEL=
# DISCUSSION_AI_API_KEY=
